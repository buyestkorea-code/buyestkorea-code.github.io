# Copy this file to .env on this computer. Never commit .env or paste keys into chat.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
HF_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
# Optional cloud render adapter; local rendering uses FFmpeg without subscription.
CREATOMATE_API_KEY=
# Use an absolute executable path only if ffmpeg is not on PATH.
FFMPEG_PATH=ffmpeg
# Optional licensed background music file; omitted means narration only.
STUDIO_MUSIC_PATH=
PORT=4317
